# ==============================================================================
# STORE ANH - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Rename this file to .env and adjust variables as needed.
# ==============================================================================

# Application Server
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webbanmt_db
DB_CONNECTION_LIMIT=10

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_secret_before_deployment
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_here

# VNPAY Sandbox Configuration
VNP_TMN_CODE=your_sandbox_terminal_code
VNP_HASH_SECRET=your_sandbox_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5000/payment/result.html

# Docker Compose only (safe local development values; change before deployment)
MYSQL_ROOT_PASSWORD=store_anh_local_root_password
MYSQL_USER=store_anh_user
MYSQL_PASSWORD=store_anh_local_password
